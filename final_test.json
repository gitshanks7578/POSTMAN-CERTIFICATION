{
  "info": {
    "_postman_id": "6a1aa7b8-9524-4c66-9f46-daacd0eae8d5",
    "name": "Postman Library API v2 Copy - Final Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "49663479"
  },
  "item": [
    {
      "name": "get books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      },
      "response": []
    },
    {
      "name": "get fiction books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?genre=fiction&checkedOut=false",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {"key": "genre", "value": "fiction"},
            {"key": "checkedOut", "value": "false"}
          ]
        }
      },
      "response": []
    },
    {
      "name": "get book by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/:id",
          "host": ["{{baseUrl}}"],
          "path": ["books", ":id"],
          "variable": [{"key": "id"}]
        }
      },
      "response": []
    },
    {
      "name": "add a book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.response.json().id;",
              "pm.collectionVariables.set('id', id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"To Kill a Mockingbird\",\n  \"author\": \"Harper Lee\",\n  \"genre\": \"fiction\",\n  \"yearPublished\": 1960\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        }
      },
      "response": []
    },
    {
      "name": "checkout book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Book checked out successfully', function() {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{ \"checkedOut\": true }"
        },
        "url": {
          "raw": "{{baseUrl}}/books/:id",
          "host": ["{{baseUrl}}"],
          "path": ["books", ":id"],
          "variable": [{"key": "id"}]
        }
      },
      "response": []
    },
    {
      "name": "delete book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Book deleted successfully', function() {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/:id",
          "host": ["{{baseUrl}}"],
          "path": ["books", ":id"],
          "variable": [{"key": "id"}]
        }
      },
      "response": []
    },
    {
      "name": "skill check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Save actorName as collection variable favoriteActor",
              "const responseJson = pm.response.json();",
              "pm.collectionVariables.set('favoriteActor', responseJson.data.actorName);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actorName\": \"Leonardo DiCaprio\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{skillcheckBaseUrl}}/post?movieName=Inception",
          "host": ["{{skillcheckBaseUrl}}"],
          "path": ["post"],
          "query": [{"key": "movieName", "value": "Inception"}]
        },
        "auth": {
          "type": "apikey",
          "apikey": [
            {"key": "key", "value": "student-expert", "type": "string"},
            {"key": "value", "value": "skillcheck", "type": "string"}
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {"key": "key", "value": "api-key", "type": "string"},
      {"key": "value", "value": "postmanrulz", "type": "string"}
    ]
  },
  "variable": [
    {"key": "baseUrl", "value": "https://library-api.postmanlabs.com"},
    {"key": "id", "value": ""},
    {"key": "skillcheckBaseUrl", "value": "https://postman-echo.com"}
  ]
}
